ARG BASE=3fs-dev
FROM ${BASE}
# Runtime for the single-node launcher: FDB server bits + run.sh dependencies.
# All 22.04 sonames already live in the base dev image, so binaries built by the
# builder service run here with no compat directory and no LD_LIBRARY_PATH.
ARG SCCACHE_VERSION=0.18.0
RUN apt-get update && apt-get install -y --no-install-recommends \
      ccache iproute2 gettext-base wget xz-utils && \
    wget -q "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz" && \
    tar -xzf "sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz" && \
    mv "sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl/sccache" /usr/local/bin/sccache && \
    rm -rf "sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl"* && \
    wget -q https://github.com/apple/foundationdb/releases/download/7.3.63/foundationdb-server_7.3.63-1_amd64.deb && \
    dpkg -i foundationdb-server_7.3.63-1_amd64.deb && \
    rm foundationdb-server_7.3.63-1_amd64.deb && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
